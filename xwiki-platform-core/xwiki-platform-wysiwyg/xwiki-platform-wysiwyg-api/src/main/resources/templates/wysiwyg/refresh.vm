  #end
  #if (!$sourceSyntax)
    #set ($sourceSyntax = $tdoc.syntax)
  #end
  #if (!$editorSyntax)
    #set ($discard = $response.sendError(400, 'The editor syntax is missing or not valid.'))
  #else
    ## Make sure the edited content is rendered for view because this is a WYSIWYG editor.
    #set ($discard = $xcontext.setDisplayMode('view'))
    #set ($restricted = $request.restricted == 'true')
    #try('refreshException')
      #set ($output = $services.wysiwyg.refresh("$!request.content", $editorSyntax, $sourceSyntax,
        $doc.documentReference, $restricted))
    #end
    #if ($refreshException)
      #set ($discard = $response.sendError(500, 'Failed to execute the macro calls of the edited content.'))
    #else
      #rawResponse($output 'text/plain')
    #end

{
  "name": "@xwiki/platform-collaboration-toolbar",
  "version": "18.9.1-SNAPSHOT",
  "license": "LGPL-2.1-or-later",
  "author": "XWiki Org Community <contact@xwiki.org>",
  "homepage": "https://xwiki.org/",
  "repository": {
    "type": "git",
    "directory": "xwiki-platform-core/xwiki-platform-node/src/main/node/core/collaboration/collaboration-toolbar",
    "url": "git+https://github.com/xwiki/xwiki-platform.git"
  },
  "bugs": {
    "url": "https://jira.xwiki.org/projects/XWIKI/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.umd.js"
      }
    }
  },
  "main": "./dist/index.es.js",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__"
  ],
  "scripts": {
    "api-extractor:ci": "api-extractor run",
    "api-extractor:local": "api-extractor run --local",
    "build": "vite build",
    "clean": "rimraf dist",
    "lint": "eslint \"./src/**/*.{ts,tsx,vue}\" --max-warnings=0",
    "test": "vitest --run",
    "typecheck": "vue-tsc"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@xwiki/platform-autosave-api": "workspace:*",
    "@xwiki/platform-autosave-xwiki": "workspace:*",
    "@xwiki/platform-collaboration-api": "workspace:*",
    "@xwiki/platform-document-xwiki": "workspace:*",
    "@xwiki/platform-xwiki-model-api": "workspace:*",
    "@xwiki/platform-xwiki-utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "3.x",
    "vue-i18n": "11.x"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@vue/test-utils": "catalog:",
    "@xwiki/platform-dev-config": "workspace:*",
    "@xwiki/platform-test-requirejs": "workspace:*",
    "@xwiki/platform-tool-apiextractorconfig": "workspace:*",
    "@xwiki/platform-tool-tsconfig": "workspace:*",
    "@xwiki/platform-tool-tsdocconfig": "workspace:*",
    "@xwiki/platform-tool-viteconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-tsc": "catalog:"
  }
}

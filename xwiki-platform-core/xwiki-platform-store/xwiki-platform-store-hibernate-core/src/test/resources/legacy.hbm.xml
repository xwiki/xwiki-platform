<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD//EN"
  "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="org.xwiki.store.hibernate.internal.LegacyEntity" table="legacyentity">
    <id name="id" column="LE_ID" unsaved-value="undefined">
      <generator class="assigned" />
    </id>
    <property name="name" column="LE_NAME" length="255" />
  </class>
</hibernate-mapping>

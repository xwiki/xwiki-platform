  #set ($syntax = $NULL)
  #if ("$!request.syntax" != '')
    #set ($syntax = $services.rendering.resolveSyntax($request.syntax))
  #end
  #if (!$syntax)
    #set ($syntax = $tdoc.syntax)
  #end
  ## Make sure the edited content is rendered for view because this is a WYSIWYG editor.
  #set ($discard = $xcontext.setDisplayMode('view'))
  #set ($editorSyntax = $services.rendering.resolveSyntax('blocknote/1.0'))
  #set ($restricted = $request.restricted == 'true')
  #try('refreshException')
    #set ($output = $services.wysiwyg.refresh("$!request.content", $editorSyntax, $syntax, $doc.documentReference,
      $restricted))
  #end
  #if ($refreshException || !$output)
    #set ($discard = $response.sendError(500, 'Failed to execute the macro calls of the edited content.'))
  #else
    #rawResponse($output 'application/json')
  #end
#end

# Helper for the editors supporting EditorConfig (https://editorconfig.org/), see the file encoding rules at
# https://dev.xwiki.org/xwiki/bin/view/Community/DevelopmentPractices#HFileencoding
# These rules are enforced by Checkstyle, whatever the editor used.
root = true

[*]
charset = utf-8

# Properties files (including translation files) are loaded as ISO-8859-1.
[*.properties]
charset = latin1

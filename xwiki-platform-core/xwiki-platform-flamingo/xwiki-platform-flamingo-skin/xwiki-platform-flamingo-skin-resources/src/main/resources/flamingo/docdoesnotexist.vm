###
### Document does not exist message
###
###
#if ($services.distribution.jobStatus && $services.distribution.jobStatus.state.name() != 'FINISHED' && $services.distribution.canDisplayDistributionWizard())
  $response.sendRedirect($xwiki.getURL('XWiki.Distribution', 'distribution', "xredirect=$escapetool.url($xwiki.relativeRequestURL)"))
#else
  $response.setStatus(404)
  #template("startpage.vm")
  <div class="main">
  #template("hierarchy.vm")
  ## Set as an HTML main for better DOM tree semantics to facilitate navigation with assistive technologies.
  <main id="mainContentArea">
  #if($xwiki.exists("XWiki.DocumentDoesNotExist"))
    #set ($titleToDisplay = $escapetool.xml($doc.getPlainTitle()))
    #template('contentheader.vm')
    $xwiki.includeForm("XWiki.DocumentDoesNotExist",false)
  #else
    #_displayDocDoesNotExist()
  #end
  <div class="clearfloats"></div>
  </main>## mainContentArea
  </div>## main
  #template("endpage.vm")
#end
##
## Display any existing UI Extensions, sorted by order.
##
#macro (showExtensions)
  $services.uix.renderExtensions('org.xwiki.platform.docdoesnotexist', 'html/5.0', {'sortByParameter': 'order'})
#end
##
## Display the "Page not found" or the "Page moved to recycle bin" message, depending on the recycle bin content.
##
#macro (_displayDocDoesNotExist)
  #set ($deletedDocuments = $xwiki.getDeletedDocuments($tdoc.fullName, $tdoc.locale))
  #set ($deletedDocumentsMessage = $NULL)
  #set ($deletedTerminalDocuments = [])
  #if ($doc.documentReference.name == 'WebHome')
    ## Also look for deleted terminal pages sharing the same location, see recyclebinlist.vm.
    #set ($deletedTerminalDocuments = $xwiki.getDeletedDocuments($tdoc.space, $tdoc.locale))
  #end
  #set ($latestDeletedDocument = $NULL)
  #if (!$deletedDocuments.isEmpty())
    #set ($latestDeletedDocument = $deletedDocuments[0])
  #elseif (!$deletedTerminalDocuments.isEmpty())
    #set ($latestDeletedDocument = $deletedTerminalDocuments[0])
  #end
  #set ($canCreate = $hasEdit && !$isReadOnly)
  #set ($displayRecycleBin = false)
  #if ($latestDeletedDocument)
    #set ($titleKey = 'core.viewers.content.deleted.title')
    ## The recycle bin table is useful only to the users who can view, restore or delete its entries.
    #set ($canRestore = $latestDeletedDocument.canUndelete())
    #set ($displayRecycleBin = $canRestore || $latestDeletedDocument.canDelete() || $latestDeletedDocument.canView())
  #else
    #set ($titleKey = 'core.viewers.content.doesnotexist.title')
  #end
  <div class="row document-header">
    <section class="document-info col-xs-12 #if ($canCreate)col-md-7#end"
      aria-label="$escapetool.xml($services.localization.render('core.document.header.info.label'))">
      <div id="document-title"><h1>$escapetool.xml($services.localization.render($titleKey))</h1></div>
    </section>
    #if ($canCreate)
      <nav class="document-menu col-xs-12 col-md-5"
        aria-label="$escapetool.xml($services.localization.render('core.document.header.menu.nav.label'))">
        #_displayDocDoesNotExistCreateButton()
      </nav>
    #end
  </div>
  <div class="docdoesnotexist">
    #set ($pageTitle = $doc.plainTitle)
    #if (!$latestDeletedDocument)
      <p class="docdoesnotexist-hint">#if ($canCreate)
        $escapetool.xml($services.localization.render('core.viewers.content.doesnotexist.hint'))
      #else
        $escapetool.xml($services.localization.render('core.viewers.content.doesnotexist.hintNoCreate'))
      #end</p>
    #elseif ($displayRecycleBin && $canRestore)
      <p class="docdoesnotexist-hint">#if ($canCreate)
        $escapetool.xml($services.localization.render('core.viewers.content.deleted.hint', [$pageTitle]))
      #else
        $escapetool.xml($services.localization.render('core.viewers.content.deleted.hintNoCreate', [$pageTitle]))
      #end</p>
    #else
      ## The deleter is displayed as a link, so it's inserted only once the rest of the message is escaped.
      #set ($deleterPlaceholder = '__docdoesnotexist_deleter__')
      #set ($deletedInfo = $services.localization.render('core.viewers.content.deleted.info',
        [$pageTitle, $deleterPlaceholder, $xwiki.formatDate($latestDeletedDocument.date)]))
      <p class="docdoesnotexist-hint">
        $escapetool.xml($deletedInfo).replace($deleterPlaceholder, $xwiki.getUserName($latestDeletedDocument.deleter))
        #if ($canCreate)
          $escapetool.xml($services.localization.render('core.viewers.content.deleted.infoCreate'))
        #end
      </p>
    #end
    #if ($displayRecycleBin)
      #template('recyclebinlist.vm')
    #end
    ## UI Extensions, if any.
    #showExtensions()
  </div>
#end
##
## Display the split button used to create the missing page. Its dropdown lets advanced users pick the editor.
## The ids are those of the regular edit menu so that the edit entries can be found at the same place.
##
#macro (_displayDocDoesNotExistCreateButton)
  #template('menus_macros.vm')
  #set ($extraAttributes = 'rel="nofollow"')
  #set ($menuContent = '')
  #if ($isAdvancedUser)
    #define ($menuContent)
      <dt class="dropdown-header sr-only">
        $escapetool.xml($services.localization.render('core.menu.edit.dropdown.hint'))
      </dt>
      <dd>
        <ul>
          #if ($services.wysiwyg.isSyntaxSupported($tdoc.syntax.toIdString()))
            #submenuitem($doc.getURL('edit', 'editor=wysiwyg'), $services.localization.render('core.menu.edit.wysiwyg'),
              'tmEditWysiwyg', '', 'pencil', $extraAttributes)
          #end
          #submenuitem($doc.getURL('edit', 'editor=wiki'), $services.localization.render('core.menu.edit.wiki'),
            'tmEditWiki', '', 'wrench', $extraAttributes)
          #submenuitem($doc.getURL('edit', 'editor=inline'), $services.localization.render('core.menu.edit.inline'),
            'tmEditInline', '', 'list', $extraAttributes)
          #submenuitem($doc.getURL('edit', 'editor=object'), $services.localization.render('core.menu.edit.object'),
            'tmEditObject', '', 'bricks', $extraAttributes)
          #submenuitem($doc.getURL('edit', 'editor=class'), $services.localization.render('core.menu.edit.class'),
            'tmEditClass', '', 'box', $extraAttributes)
        </ul>
      </dd>
    #end
  #end
  <ul id="contentmenu" class="pull-right actionmenu">
    #displayMenu('tmEdit', 'add', $menuContent, 'core.viewers.content.doesnotexist.create', true, $doc.getURL('create'),
      $extraAttributes, true)
  </ul>
#end

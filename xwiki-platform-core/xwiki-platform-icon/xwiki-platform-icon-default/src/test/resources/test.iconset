## General settings
xwiki.iconset.type = font
xwiki.iconset.css = http://url_to_css
xwiki.iconset.ssx = IconThemes.Default
xwiki.iconset.jsx = IconThemes.JS
xwiki.iconset.render.wiki = {{html clean="false"}}<span class="fa fa-$icon"></span>{{/html}}
xwiki.iconset.render.html = <span class="fa fa-$icon"></span>
xwiki.iconset.icon.url = http://url_to_image/$icon.png
xwiki.iconset.icon.cssClass = fa fa-$icon

## Icons
transmit = anchor
earth = globe

#@deprecatedstart
## Deprecated since 18.10.0RC1.
old_earth = globe
#@deprecatedend

## Icons after a deprecated block
satellite=signal

#@deprecatedstart
old_transmit:anchor
#@deprecatedend
